[Unit]
Description=Habibot Voice Interaction Service
After=network.target sound.target

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/Unitree
ExecStart=/usr/bin/python3 /home/unitree/Unitree/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment="GEMINI_API_KEY=your_api_key_here"
Environment="RUN_ON_ROBOT=true"
Environment="ROBOT_NETWORK_INTERFACE=eth0"

[Install]
WantedBy=multi-user.target
